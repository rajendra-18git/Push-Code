{"manifest_version": 3, "name": "CodePush — Solved Problems to GitHub", "version": "1.1.0", "description": "Push your solved problems from GeeksforGeeks, HackerRank and CodeChef straight to your GitHub repository, organised by platform.", "permissions": ["storage", "activeTab", "sidePanel"], "host_permissions": ["https://api.github.com/*", "https://www.geeksforgeeks.org/*", "https://practice.geeksforgeeks.org/*", "https://www.hackerrank.com/*", "https://www.codechef.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_title": "CodePush — open panel", "default_icon": {"48": "icon.png", "128": "icon.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "content_scripts": [{"matches": ["https://www.geeksforgeeks.org/*", "https://practice.geeksforgeeks.org/*", "https://www.hackerrank.com/*", "https://www.codechef.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"48": "icon.png", "128": "icon.png"}}